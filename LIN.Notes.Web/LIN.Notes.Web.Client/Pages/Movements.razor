@page "/movements"
@using LIN.Types.Notes.Enumerations
@inject NavigationManager NavigationManager

<PageTitle>Gastos</PageTitle>

<LIN.Notes.Web.Client.Shared.AuthorizationControl />

<div class="UIScroll fade-in flex min-h-screen w-full justify-center overflow-y-auto overflow-x-hidden">
    <div class="flex w-full flex-col px-4 pb-10 pt-9 lg:px-10">

        @* Botón de atrás *@
        <div class="mb-5">
            <button @onclick='()=>NavigationManager.NavigateTo("/home")' type="button" class="bg-white/40 flex h-12 w-12 items-center justify-center rounded-full p-2 text-sm text-gray-700 transition-colors duration-200 hover:bg-white/60 dark:bg-zinc-500/30 dark:text-gray-200 dark:hover:bg-zinc/50">
                <svg class="h-6 w-6 rtl:rotate-180" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 15.75L3 12m0 0l3.75-3.75M3 12h18" />
                </svg>
            </button>
        </div>

        @* Título *@
        <label class="text-8xl font-bold text-zinc-900 dark:text-white">Mis</label>
        <label class="text-7xl font-medium text-zinc-800 dark:text-zinc-300">Gastos</label>

        @* Resumen *@
        @if (MovementsList != null && MovementsList.Response == Responses.Success)
        {
            <div class="mt-6 rounded-2xl bg-zinc-900 px-6 py-5 dark:bg-zinc-800">

                <label class="text-xs font-medium uppercase tracking-widest text-zinc-400">Balance</label>
                <p class="mt-1 text-4xl font-bold @(Balance >= 0 ? "text-emerald-400" : "text-red-400")">
                    @FormatAmount(Balance)
                </p>

                <div class="mt-4 flex items-center gap-6">

                    <div>
                        <div class="flex items-center gap-1.5">
                            <div class="flex h-5 w-5 items-center justify-center rounded-full bg-emerald-500/20">
                                <svg class="h-3 w-3 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 10.5L12 3m0 0l7.5 7.5M12 3v18" />
                                </svg>
                            </div>
                            <label class="text-xs text-zinc-400">Ingresos</label>
                        </div>
                        <p class="mt-0.5 text-lg font-semibold text-emerald-400">@FormatAmount(TotalIncome)</p>
                    </div>

                    <div class="h-8 w-px bg-zinc-700"></div>

                    <div>
                        <div class="flex items-center gap-1.5">
                            <div class="flex h-5 w-5 items-center justify-center rounded-full bg-red-500/20">
                                <svg class="h-3 w-3 text-red-400" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5L12 21m0 0l-7.5-7.5M12 21V3" />
                                </svg>
                            </div>
                            <label class="text-xs text-zinc-400">Gastos</label>
                        </div>
                        <p class="mt-0.5 text-lg font-semibold text-red-400">@FormatAmount(TotalExpense)</p>
                    </div>

                </div>
            </div>
        }

        @* Formulario de nuevo movimiento *@
        <div class="mt-6">
            @if (!ShowForm)
            {
                <button @onclick="()=>ShowForm=true" class="flex w-full items-center justify-center gap-2 rounded-xl border-2 border-dashed border-zinc-300 py-3 text-sm font-medium text-zinc-500 transition-colors hover:border-zinc-400 hover:text-zinc-700 dark:border-zinc-600 dark:text-zinc-400 dark:hover:border-zinc-500 dark:hover:text-zinc-300">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                    </svg>
                    Agregar movimiento
                </button>
            }
            else
            {
                <div class="rounded-2xl bg-zinc-100 p-5 dark:bg-zinc-800/60">

                    <label class="text-sm font-semibold text-zinc-700 dark:text-zinc-200">Nuevo movimiento</label>

                    @* Selector de tipo *@
                    <div class="mt-3 flex gap-2">
                        <button @onclick="()=>NewType=MovementType.Expense"
                                class="flex flex-1 items-center justify-center gap-2 rounded-xl py-2.5 text-sm font-medium transition-colors @(NewType == MovementType.Expense ? "bg-red-500 text-white" : "bg-zinc-200 text-zinc-600 dark:bg-zinc-700 dark:text-zinc-300")">
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5L12 21m0 0l-7.5-7.5M12 21V3" />
                            </svg>
                            Gasto
                        </button>
                        <button @onclick="()=>NewType=MovementType.Income"
                                class="flex flex-1 items-center justify-center gap-2 rounded-xl py-2.5 text-sm font-medium transition-colors @(NewType == MovementType.Income ? "bg-emerald-500 text-white" : "bg-zinc-200 text-zinc-600 dark:bg-zinc-700 dark:text-zinc-300")">
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 10.5L12 3m0 0l7.5 7.5M12 3v18" />
                            </svg>
                            Ingreso
                        </button>
                    </div>

                    @* Monto *@
                    <div class="mt-3">
                        <label class="text-xs font-medium text-zinc-500 dark:text-zinc-400">Monto</label>
                        <input @bind="NewAmount" @bind:event="oninput" type="number" min="0" step="0.01"
                               class="mt-1 w-full rounded-xl bg-white px-4 py-2.5 text-zinc-900 outline-none ring-1 ring-zinc-200 focus:ring-2 focus:ring-zinc-400 dark:bg-zinc-700 dark:text-white dark:ring-zinc-600 dark:focus:ring-zinc-400"
                               placeholder="0.00" />
                    </div>

                    @* Fecha *@
                    <div class="mt-3">
                        <label class="text-xs font-medium text-zinc-500 dark:text-zinc-400">Fecha</label>
                        <input @bind="NewDate" type="date"
                               class="mt-1 w-full rounded-xl bg-white px-4 py-2.5 text-zinc-900 outline-none ring-1 ring-zinc-200 focus:ring-2 focus:ring-zinc-400 dark:bg-zinc-700 dark:text-white dark:ring-zinc-600 dark:focus:ring-zinc-400" />
                    </div>

                    @* Acciones *@
                    <div class="mt-4 flex gap-2">
                        <button @onclick="()=>ShowForm=false" class="flex-1 rounded-xl bg-zinc-200 py-2.5 text-sm font-medium text-zinc-600 transition-colors hover:bg-zinc-300 dark:bg-zinc-700 dark:text-zinc-300 dark:hover:bg-zinc-600">
                            Cancelar
                        </button>
                        <button @onclick="Create" disabled="@IsSaving" class="flex-1 rounded-xl bg-zinc-900 py-2.5 text-sm font-medium text-white transition-colors hover:bg-zinc-700 disabled:opacity-50 dark:bg-white dark:text-zinc-900 dark:hover:bg-zinc-100">
                            @if (IsSaving) { <span>Guardando...</span> } else { <span>Guardar</span> }
                        </button>
                    </div>

                </div>
            }
        </div>

        @* Lista de movimientos *@
        <div class="mt-5 flex flex-col gap-2 pb-6">

            @if (MovementsList == null)
            {
                <div class="flex w-full justify-center p-8">
                    <Loader />
                </div>
            }
            else if (MovementsList.Response != Responses.Success || !MovementsList.Models.Any())
            {
                <div class="mt-3 flex w-full items-center justify-center rounded-xl border-2 border-dashed border-zinc-300 py-10 dark:border-zinc-600">
                    <label class="text-zinc-400 dark:text-zinc-500">No tienes movimientos registrados</label>
                </div>
            }
            else
            {
                @foreach (var movement in MovementsList.Models.OrderByDescending(m => m.Date))
                {
                    <div class="group flex items-center gap-3 rounded-xl bg-zinc-50 px-4 py-3 dark:bg-zinc-800/50">

                        @* Ícono de tipo *@
                        <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full @(movement.Type == MovementType.Income ? "bg-emerald-100 dark:bg-emerald-500/20" : "bg-red-100 dark:bg-red-500/20")">
                            @if (movement.Type == MovementType.Income)
                            {
                                <svg class="h-5 w-5 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 10.5L12 3m0 0l7.5 7.5M12 3v18" />
                                </svg>
                            }
                            else
                            {
                                <svg class="h-5 w-5 text-red-600 dark:text-red-400" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5L12 21m0 0l-7.5-7.5M12 21V3" />
                                </svg>
                            }
                        </div>

                        @* Info *@
                        <div class="flex flex-1 flex-col">
                            <span class="text-sm font-semibold @(movement.Type == MovementType.Income ? "text-emerald-700 dark:text-emerald-400" : "text-red-700 dark:text-red-400")">
                                @(movement.Type == MovementType.Income ? "+" : "-")@FormatAmount(movement.Amount)
                            </span>
                            <span class="text-xs text-zinc-400">@movement.Date.ToString("dd MMM yyyy")</span>
                        </div>

                        @* Eliminar *@
                        <button @onclick="()=>DeleteMovement(movement)" class="invisible flex h-8 w-8 items-center justify-center rounded-full text-zinc-400 hover:bg-zinc-200 group-hover:visible dark:hover:bg-zinc-700">
                            <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 448 512">
                                <path d="M135.2 17.7L128 32H32C14.3 32 0 46.3 0 64S14.3 96 32 96H416c17.7 0 32-14.3 32-32s-14.3-32-32-32H320l-7.2-14.3C307.4 6.8 296.3 0 284.2 0H163.8c-12.1 0-23.2 6.8-28.6 17.7zM416 128H32L53.2 467c1.6 25.3 22.6 45 47.9 45H346.9c25.3 0 46.3-19.7 47.9-45L416 128z" />
                            </svg>
                        </button>

                    </div>
                }
            }

        </div>

    </div>
</div>
