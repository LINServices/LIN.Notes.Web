@page "/"

<PageTitle>Iniciar sesión</PageTitle>

<LIN.Notes.Web.Client.Layout.AuthLayout>

    <LeftContent>
        @if (_isAnimating)
        {
            <div class="flex flex-col items-center justify-center gap-3">
                <Success />
            </div>
        }
        else if (_isLoggingIn)
        {
            <div class="flex flex-col items-center justify-center gap-3">
                <Loader />
                <p class="text-body text-muted">@_loadingMessage</p>
                @if (_isCancelVisible)
                {
                    <button @onclick="CancelPassKey" type="button"
                            class="text-label text-muted transition-colors hover:text-ink">
                        Cancelar
                    </button>
                }
            </div>
        }
        else if (_orgAlternatives.Count > 0)
        {
            <h1 class="text-ink mb-2 font-medium leading-tight tracking-tight text-[2.5rem] md:text-[3.5rem]">Elige tu organización</h1>
            <p class="text-body text-muted mb-8">Tu cuenta pertenece a varias organizaciones, selecciona con cuál continuar.</p>

            <div class="border-line bg-surface-alt mb-4 rounded-2xl border p-2.5">
                @foreach (var org in _orgAlternatives)
                {
                    <div class="mt-1 flex items-center justify-between p-2 first:mt-0">
                        <span class="text-title text-ink">@org.Name</span>
                        <button @onclick="() => SelectOrganization(org)" class="rounded-xl bg-ink px-4 py-2.5 text-title text-surface transition-opacity hover:opacity-90 focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current-500">
                            Entrar
                        </button>
                    </div>
                }
            </div>
        }
        else
        {
            <!-- Heading -->
            <div @key="_isWithKey" class="login-fade-in">
                <h1 class="text-ink mb-2 font-medium leading-tight tracking-tight text-[2.5rem] md:text-[3.5rem]">
                    @(_isWithKey ? "Iniciar con passkey" : "Bienvenido de nuevo")
                </h1>
                <p class="text-body text-muted mb-8">
                    @(_isWithKey ? "Usa tu llave de acceso para continuar." : "Ingresa tus credenciales para acceder a tu directorio.")
                </p>
            </div>

            @if (_errorVisibility != "hidden")
            {
                <div @key="_errorMessage" class="login-fade-in border-line bg-surface mb-6 flex items-start gap-2.5 rounded-xl border px-3.5 py-3">
                    <svg xmlns="http://www.w3.org/2000/svg" class="text-danger-600 mt-0.5 h-4 w-4 shrink-0" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm.93-9.412-.267 4.55h-1.324l-.267-4.55h1.858zM8 11.882a.98.98 0 1 1 0-1.96.98.98 0 0 1 0 1.96z" />
                    </svg>
                    <p class="text-body text-danger-700">@_errorMessage</p>
                </div>
            }

            <!-- Fields -->
            <div class="flex flex-col gap-4">

                <div class="flex flex-col gap-1.5">
                    <label class="text-label text-muted block">Usuario</label>
                    <input @onkeypress="HideError" @bind="_username" type="text" autocomplete="off"
                           class="text-body border-line bg-surface text-ink w-full rounded-xl border px-4 py-2.5 outline-none transition-colors placeholder:text-muted focus:border-line-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current-500" />
                </div>

                @if (!_isWithKey)
                {
                    <div class="login-fade-in flex flex-col gap-1.5">
                        <label class="text-label text-muted block">Contraseña</label>
                        <input @onkeypress="HideError" @bind="_password" type="password" autocomplete="off"
                               class="text-body border-line bg-surface text-ink w-full rounded-xl border px-4 py-2.5 outline-none transition-colors placeholder:text-muted focus:border-line-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current-500" />
                    </div>
                }

            </div>

            <!-- Actions -->
            <div class="mt-5 flex gap-2">
                <button @onclick="StartAuthentication"
                        class="text-title bg-ink text-surface inline-flex flex-1 cursor-pointer items-center justify-center overflow-hidden rounded-xl py-2.5 transition-opacity hover:opacity-90 focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current-500">
                    <span @key="_isWithKey" class="login-fade-in">@(_isWithKey ? "Continuar con passkey" : "Iniciar sesión")</span>
                </button>
                <button @onclick="TogglePassKeyMode" type="button" title="@(_isWithKey ? "Cancelar passkey" : "Usar passkey")"
                        class="border-line bg-surface text-ink inline-flex size-10 shrink-0 cursor-pointer items-center justify-center overflow-hidden rounded-xl border transition-colors hover:border-line-strong focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current-500">
                    @if (_isWithKey)
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" class="login-fade-scale h-4 w-4" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8 2.146 2.854Z" />
                        </svg>
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" class="login-fade-scale h-4 w-4" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M2 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2zm7 11a1 1 0 1 0-2 0 1 1 0 0 0 2 0z" />
                        </svg>
                    }
                </button>
            </div>

            <div class="mt-4 flex items-center justify-between">
                <a href="/register" class="text-body text-muted cursor-pointer transition-colors hover:text-ink">
                    ¿No tienes cuenta? <span class="font-medium text-current-700 hover:text-current-800">Regístrate</span>
                </a>
            </div>
        }
    </LeftContent>

    <RightContent>
        <p class="text-heading text-ink mb-4">
            "Gestiona tu equipo de manera eficiente, conectando a cada miembro con los recursos y políticas que necesitan para trabajar juntos."
        </p>
        <p class="text-label text-muted">LIN Human Directory</p>
    </RightContent>

</LIN.Notes.Web.Client.Layout.AuthLayout>
